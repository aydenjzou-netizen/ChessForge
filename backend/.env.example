STORAGE_MODE=postgres
LOCAL_USER_ID=00000000-0000-4000-8000-000000000001
GOOGLE_CLIENT_ID=replace-with-google-web-client-id.apps.googleusercontent.com
FRONTEND_ORIGIN=http://localhost:5173
SESSION_TTL_SECONDS=604800
COOKIE_SECURE=false
PRIVACY_NOTICE_URL=http://localhost:5173/privacy.html
PRIVACY_OPERATOR_NAME=ChessForge Development
PRIVACY_CONTACT_EMAIL=privacy@example.invalid
PRIVACY_ASSESSMENT_TTL_MINUTES=60
PRIVACY_CONSENT_TTL_HOURS=72
PRIVACY_ALLOW_DEV_GUARDIAN_APPROVAL=true
# PRIVACY_EMAIL_WEBHOOK_URL=https://email-service.example/send
# PRIVACY_EMAIL_WEBHOOK_TOKEN=replace-with-secret
# PRIVACY_VPC_START_URL=https://verification-provider.example/start
# PRIVACY_VPC_WEBHOOK_SECRET=replace-with-long-random-secret
# Comma-separated processor deletion callback endpoints.
# PRIVACY_DELETION_WEBHOOK_URLS=https://processor-a.example/privacy/delete,https://processor-b.example/privacy/delete
# PRIVACY_DELETION_WEBHOOK_TOKEN=replace-with-secret
PRIVACY_SECURITY_LOG_RETENTION_DAYS=180

# Azure Database for PostgreSQL Flexible Server. Supply the real URL as a protected secret.
# DATABASE_URL=postgresql://app_user:password@server.postgres.database.azure.com:5432/chessforge?sslmode=verify-full
# DB_POOL_SIZE=10
# DB_APPLICATION_NAME=chessforge-api
# DB_CONNECT_TIMEOUT_MS=10000
# DB_IDLE_TIMEOUT_MS=30000

# Local PostgreSQL (used by compose.yaml):
# STORAGE_MODE=postgres
# DATABASE_URL=postgresql://chessforge:local-development-only@localhost:5432/chessforge
