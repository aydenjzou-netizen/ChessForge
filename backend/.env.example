# Phase 0 migration control. Keep legacy authoritative until Phase 2 is approved.
STORAGE_MODE=legacy
LOCAL_STORAGE_DIR=./app-data
LOCAL_USER_ID=00000000-0000-4000-8000-000000000001

# STORAGE_DRIVER=filesystem remains temporarily supported for compatibility.
# Do not set STORAGE_MODE and STORAGE_DRIVER to conflicting values.

# Phase 2 only:
# STORAGE_MODE=dual-write

# Set these when switching authoritative storage to PostgreSQL.
# STORAGE_MODE=postgres
# DATABASE_URL=postgresql://app_user:password@server.postgres.database.azure.com:5432/chessforge?sslmode=verify-full
# DB_POOL_SIZE=10
